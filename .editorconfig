root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Spaces are mandatory, not stylistic: the MoneyMoney signing process expands
# tabs to 8 spaces, which corrupts the signed file.
[*.lua]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
